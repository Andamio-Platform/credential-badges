# nginx config for the credential-badges static host.
#
# The registered media type for JSON-LD is application/ld+json, which is NOT in
# nginx's stock mime.types — without a mapping a `.jsonld` file falls back to
# `default_type` (application/octet-stream), violating the OB 3.0 Content-Type
# requirement and breaking strict verifiers. Add the one missing mapping.
#
# NOTE: this `types {}` block is in the http context (conf.d is included into
# http), where `types` blocks ACCUMULATE onto the stock map (`include
# mime.types`) rather than replacing it — so every other served type (json,
# svg, png, jpeg, webp) still resolves from mime.types. Re-listing those here
# only re-defines them and produces "duplicate extension" warnings; keep this
# block limited to extensions stock mime.types does not already cover.
types {
    application/ld+json  jsonld;
}

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    autoindex off;

    # Relative Location headers on redirects. nginx sits behind Cloud Run's
    # HTTPS proxy on internal port 8080; an absolute redirect would leak
    # http:// + :8080 into Location (broken for the public host). Relative
    # is RFC 7231-legal and resolves against the public origin.
    absolute_redirect off;

    # Unknown types are NOT guessed as something dangerous.
    default_type application/octet-stream;

    # Long cache: published context versions are immutable forever.
    location ~ \.jsonld$ {
        add_header Cache-Control "public, max-age=86400, immutable";
        try_files $uri =404;
    }

    # Hosted OB 3.0 issuer Profile. Credentials carry `issuer.url`
    # "https://credentials.andamio.io/issuer" (no extension); strict OB 3.0
    # verifiers dereference it and expect application/ld+json. Exact-match so
    # the request URI has no .jsonld extension — set the type explicitly
    # rather than relying on the served file's extension. Unlike versioned
    # contexts this profile is mutable, so it is cached but NOT immutable.
    location = /issuer {
        default_type application/ld+json;
        add_header Cache-Control "public, max-age=86400";
        try_files /issuer/profile.jsonld =404;
    }

    # did:web DID document. did:web:credentials.andamio.io resolves here; strict
    # OB 3.0 / DID-Core verifiers dereference it to fetch the issuer's signing
    # key. Exact-match so the type is set explicitly: application/did+ld+json is
    # DID-Core-correct for a JSON-LD DID document (the resolver is the arbiter —
    # application/json is the proven-safe fallback). Unlike immutable contexts
    # this doc is MUTABLE on key rotation, so it is cached but NOT immutable, and
    # with a shorter TTL. The key is only published here, never used to sign.
    location = /.well-known/did.json {
        # The `.json` extension maps to application/json via stock mime.types,
        # which would override `default_type`. An empty `types {}` block clears
        # the extension map for THIS location so `default_type` actually applies.
        types { }
        default_type application/did+ld+json;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # Bare-domain alias for the DID document. The did:web spec says a bare-domain
    # DID resolves at /.well-known/did.json, but some resolvers deviate and fetch
    # /did.json instead — the 1EdTech validator's resolver does exactly this (its
    # one failing probe of 13 against our signed credential; issue #54 item 8).
    # Serving the alias makes resolution robust to that deviation. The spec path
    # above stays canonical; this location serves the SAME file via try_files, so
    # there is one source of truth on disk — no second copy, no drift. Headers
    # mirror the canonical block exactly.
    location = /did.json {
        types { }
        default_type application/did+ld+json;
        add_header Cache-Control "public, max-age=3600";
        try_files /.well-known/did.json =404;
    }

    # Key-epoch BitstringStatusList credentials (Rung 8.3, deployment plan
    # Decision 3). Subject credentials point into /status/ from their
    # credentialStatus entry; verifiers dereference the URL to read the
    # key-version suspension bit. The W3C Bitstring Status List spec
    # prescribes no single media type ("might be any media type registered
    # for the purpose of expressing a verifiable credential") and lists
    # application/ld+json among the acceptable forms — the files ARE JSON-LD
    # VCs, so serve exactly that. Prefix match (`^~` so the generic .json
    # handling and regex locations never shadow it) covering the WHOLE
    # /status/ tree: the next key-epoch file inherits these headers
    # automatically instead of needing a new exact-match block (which would
    # silently serve application/json until someone remembered). The stock
    # mime.types maps the .json extension to application/json, which would
    # override default_type, so the Rung-3-style empty `types {}` block
    # clears the extension map for this location. Status lists are MUTABLE
    # on a compromised-key bit flip — the whole point is that the flip
    # propagates — so cached briefly and NOT immutable (same TTL as
    # did.json). Serving stays allowlist-gated per file: only files COPY'd
    # by the Dockerfile + passed by scripts/ci/check-allowlist.sh exist on
    # disk, so a wider location adds no serving surface.
    location ^~ /status/ {
        types { }
        default_type application/ld+json;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # Badge imagery — static-first with on-demand render fallback (#33, KTD-4).
    #
    # `^~` makes this a prefix match that OWNS /badges/ and short-circuits the
    # generic image regex below — so the 404 fallback is scoped to badge paths
    # only and never leaks to other image URLs. A baked badge (the pre-rendered
    # set copied into the image) or an already-cached badge is served straight
    # from disk; on a miss, `try_files` falls through to @render, which proxies
    # to the on-demand render service (it checks the GCS cache, renders on a
    # miss, persists, and returns the SVG).
    #
    # Badge art is MUTABLE (an issuer may refresh a graphic without
    # invalidating any credential — the OB 3.0 credential references the image
    # URL, not its bytes; the on-chain anchor is the identity), so badges are
    # cached but explicitly NOT immutable. The render service emits the same
    # `Cache-Control: public, max-age=86400`, so the header is identical
    # whether a badge is served from disk or freshly rendered.
    # `^~` owns /badges/ and short-circuits the generic image regex below. The
    # extension decides what's served (nested regex locations select by suffix;
    # a nested match runs ONLY its own directives, so each behavior is isolated):
    #   {stem}         (extensionless) -> the static display/share page (#70)
    #   {stem}.svg     -> the badge image, static-first + @render fallback (#33)
    #   {stem}.png / .og.png -> committed raster, static-only, clean 404 (#69)
    #   {stem}.html    -> the page file directly, static-only
    # The .svg/.png/.og.png URLs are byte-for-byte unchanged — an OB 3.0
    # credential references its image URL forever, so it must not move.
    location ^~ /badges/ {
        add_header Cache-Control "public, max-age=86400";
        # Default (extensionless {stem}): serve the generated page. try_files
        # internally redirects to {stem}.html, so the type resolves to text/html
        # from stock mime.types; a missing page is a clean 404 (never @render).
        try_files $uri $uri.html =404;

        # Badge image (#33, KTD-4): a baked/cached badge serves straight from
        # disk; on a miss, @render proxies to the on-demand render service (it
        # checks the GCS cache, renders, persists, returns the SVG). Badge art is
        # MUTABLE (the credential references the URL, not the bytes; the on-chain
        # anchor is identity), so cached but explicitly NOT immutable.
        location ~ \.svg$ {
            add_header Cache-Control "public, max-age=86400";
            try_files $uri @render;
        }

        # v1.2 raster artifacts (#69): the download PNG ({stem}.png) and the
        # 1200x630 Open Graph card ({stem}.og.png) are BUILD-TIME output —
        # committed, never rendered on demand. Static-only: a .png miss returns a
        # clean 404 instead of proxying to the render service (which only speaks
        # .svg via BADGE_RE) and surfacing a 502. png resolves to image/png from
        # stock mime.types (no types{} needed).
        location ~ \.png$ {
            add_header Cache-Control "public, max-age=86400";
            try_files $uri =404;
        }

        # Direct .html access to the page file (the canonical URL is the
        # extensionless form above; this serves the same bytes for a direct hit).
        location ~ \.html$ {
            add_header Cache-Control "public, max-age=86400";
            try_files $uri =404;
        }

        # Holder viewer (#73): the per-holder credential view at
        # /badges/{stem}/{alias} — the subpath KTD-7 of the #70 plan reserved.
        # A single committed static shell (_holder.html) whose client JS reads
        # {stem}+{alias} from location.pathname, resolves live on-chain +
        # suspension state (via the /holder-api/ proxy below and the same-origin
        # /status/ list), and renders it. Nested regex owns the two-segment path;
        # a malformed stem/alias never matches, so it falls through to the outer
        # try_files =404. The .svg/.png/.html sibling routes are untouched (the
        # holder path carries no such extension), so credential-referenced image
        # URLs never move (R3).
        location ~ "^/badges/[0-9a-f]{56}\.[0-9a-f]{64}/[A-Za-z0-9_-]{1,64}$" {
            add_header Cache-Control "public, max-age=86400";
            try_files /badges/_holder.html =404;
        }
    }

    # On-demand render fallback target (#33, KTD-4). RENDER_UPSTREAM is injected
    # at container start by the nginx image's envsubst templating (see
    # Dockerfile) — the render service's Cloud Run URL in production, a stub in
    # the CI fallback test. `proxy_pass` with no URI component forwards the
    # original `/badges/{cid}.{slt}.svg` request verbatim. The render service
    # sets its own `image/svg+xml` Content-Type and `Cache-Control`, which pass
    # through unchanged. `proxy_ssl_server_name` sends SNI for the HTTPS Cloud
    # Run upstream; `Host` is the upstream host (Cloud Run routes by Host), with
    # the public host preserved in X-Forwarded-Host.
    #
    # Production alternative (hardening path, NOT this repo): an external HTTPS
    # load balancer with a URL-map path-route `/badges/* -> render NEG`, defined
    # in private-ops Terraform (deployment plan Decision 5). Same render service
    # and GCS cache; only the routing layer differs.
    location @render {
        proxy_pass ${RENDER_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Holder-state proxy (#73, KTD-2). andamioscan.io sends NO CORS headers, so a
    # browser cross-origin fetch from this host is blocked; the holder viewer
    # reads a holder's live on-chain state SAME-ORIGIN through here. Mirrors
    # @render: HOLDER_UPSTREAM is the andamioscan `/api/v2/` base, injected at
    # deploy (envsubst); the default is an IP-literal discard so nginx always
    # boots and an un-wired deploy fails LOUD (502 connection-refused), never a
    # silent fake-OK. `proxy_ssl_server_name on` sends SNI for the HTTPS upstream.
    # Live state must not cache — `no-store` on the proxied response, and the
    # client also fetches with cache:"no-store". Fail-loud: an upstream non-2xx
    # passes through unchanged (no error_page masking), so the client renders an
    # explicit error, never a fabricated "verified" (R6).
    location ^~ /holder-api/ {
        proxy_pass ${HOLDER_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    # Non-badge imagery (if any is ever served outside /badges/). Cached, not
    # immutable; a miss is a plain 404 with NO render fallback — that is
    # /badges/-only, above.
    location ~* \.(svg|png|jpe?g|webp)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # Interactive credential designer (#37, PR #50) — served from its own
    # /design/ subtree so the web root stays a pure trust surface. The
    # no-slash form must 301 to the slash form: index.html loads its assets
    # via relative paths (app/, styles/, assets/), which resolve against "/"
    # if the page is served at /design without the trailing slash.
    location = /design {
        return 301 /design/;
    }

    # Minimal landing page at "/" — returns 200 so health probes succeed
    # and humans hitting the root get a pointer instead of a bare 404.
    location = / {
        # default_type, not add_header: add_header APPENDS a second
        # Content-Type on top of the server default_type (octet-stream),
        # producing a malformed double header on the root response.
        default_type text/plain;
        return 200 "Andamio credential contexts\n\nPublished JSON-LD contexts:\n  /context/v1.jsonld\n  /context/v0.jsonld (frozen)\n\nHosted issuer profile:\n  /issuer\n\nCredential status list:\n  /status/key-epoch-2026-07.json\n\nBadge imagery:\n  /badges/\n\nCredential designer:\n  /design/\n\nSee https://github.com/Andamio-Platform/credential-badges\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
